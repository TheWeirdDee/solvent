# Sidecar container environment. Copy to sidecar.env (git-ignored) and fill in.

# Must equal [info].url in mint.toml — the public URL wallets use.
SOLVENT_MINT_URL=https://mint.example.com

# SECRET — the SOLVENT manifest private key (64 hex). Signs epoch manifests
# and reserve bindings. Generate: openssl rand -hex 32
SOLVENT_MANIFEST_PRIVKEY=

# Reserve: the Mutinynet outpoint controlled by the reserve-control key file
# mounted at /secrets/reserve-key.json (deploy/secrets/reserve-key.json).
SOLVENT_RESERVE_OUTPOINT=598bfed24044ea8b37bf79d0719afcebb87a8767f91c73dc37a36f17214c58fb:0

# fakewallet (public demo) or lnd (proof mode). Must match mint.toml; it is
# shown to every user and recorded in evidence.
SOLVENT_LIGHTNING_BACKEND=fakewallet

# Demo cadence: epochs holding liabilities close about this often.
SOLVENT_EPOCH_INTERVAL_SECONDS=30
# How long published evidence stays valid — independent of the cadence.
SOLVENT_EVIDENCE_VALIDITY_SECONDS=3600

# 1 = enable the broken-promise demo endpoint. NEVER on a mint that claims
# to be honest: it lets any visitor make the mint omit an issuance.
SOLVENT_DEMO_ALLOW_OMISSION=1

# Optional: comma-separated wss:// relays (default: damus, nos.lol, nostr.band).
SOLVENT_NOSTR_RELAYS=
# Optional: a stable Nostr transport key (64 hex); default is a fresh key per start.
SOLVENT_NOSTR_SECRET_HEX=

SOLVENT_SIDECAR_PORT=8086

# Caddy (https profile): the two public hostnames.
SOLVENT_MINT_HOST=mint.example.com
SOLVENT_EVIDENCE_HOST=evidence.example.com
