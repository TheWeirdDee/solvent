# Mint container environment. Copy to mint.env (git-ignored) and fill in.

# SECRET — the mint seed. Its BIP32 master key is the mint's NUT-06 identity.
# Generate (from the repo root): node --input-type=module -e "import { generateMnemonic } from '@scure/bip39'; import { wordlist } from '@scure/bip39/wordlists/english.js'; console.log(generateMnemonic(wordlist))"
CDK_MINTD_MNEMONIC=

# PUBLIC — the SOLVENT manifest key's compressed public key (66 hex). Its
# private key goes ONLY into sidecar.env. The mint identity delegates it.
SOLVENT_MANIFEST_PUBKEY=

SOLVENT_MINT_PORT=8085
