+        .expect("3G");
+        assert!(!ok(MINT_URL, &other_key, 5, 1_790_000_000), "B");
+        assert!(!ok("https://other.example", &manifest_key(), 5, 1_790_000_000), "C");
+        assert!(!ok(MINT_URL, &manifest_key(), 6, 1_790_000_000), "D");
