+/// SOLVENT Phase 3B: `cdk-mintd solvent delegate-manifest-key`. Loads the
+/// stored configuration exactly as daemon startup does, builds the same
+/// signatory from the same seed (or connects the same remote signatory),
+/// checks it is the configured signing identity — the key NUT-06 advertises
+/// — and asks it to sign a manifest key delegation. Returns the delegation
+/// as JSON. Never exposed over HTTP; the identity key never leaves the
+/// signatory. A remote signatory has no matching RPC and fails closed. See
+/// solvent/docs/manifest-key-delegation.md.
+pub async fn solvent_delegate_manifest_key(
+    work_dir: &Path,
+    db_password: Option<String>,
+    manifest_pubkey_hex: &str,
+    valid_from_epoch: u64,
+) -> Result<String> {
+    if manifest_pubkey_hex.len() != 66 {
+        bail!("--manifest-pubkey must be a 33-byte compressed public key (66 hex characters)");
+    }
+    let manifest_pubkey = cdk::nuts::PublicKey::from_hex(manifest_pubkey_hex)
+        .map_err(|e| anyhow!("--manifest-pubkey is not a valid public key: {e}"))?;
+
+    let bootstrap = load_database_bootstrap_settings()?;
+    let (_localstore, keystore, _kv, configuration_store) =
+        initial_setup(work_dir, &bootstrap, db_password).await?;
+    let startup = configuration_service(configuration_store, &bootstrap)
+        .startup()
+        .await?;
+    let settings = startup.resolved.settings;
+
+    let signatory: DynSignatory = if settings.enabled_signatory().is_some() {
+        match startup.remote_signatory {
+            Some(remote) => remote,
+            None => bail!("remote signatory configured but not connected"),
+        }
+    } else {
+        let seed: Vec<u8> = if let Some(seed) =
+            settings.info.seed.clone().filter(|seed| !seed.is_empty())
+        {
+            seed.into()
+        } else if let Some(mnemonic) = settings
+            .info
+            .mnemonic
+            .clone()
+            .map(|s| Mnemonic::from_str(&s))
+            .transpose()?
+        {
+            mnemonic.to_seed_normalized("").to_vec()
+        } else {
+            bail!("No seed nor remote signatory set");
+        };
+        let db_signatory = cdk_signatory::db_signatory::DbSignatory::new(
+            keystore,
+            &seed,
+            Default::default(),
+            Default::default(),
+        )
+        .await?;
+        Arc::new(cdk_signatory::embedded::Service::new(Arc::new(db_signatory)))
+    };
+    ensure_signatory_identity(&signatory, startup.signing_identity.pubkey).await?;
+
+    let created_at = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)?
+        .as_secs();
+    let delegation = signatory
+        .sign_manifest_key_delegation(
+            settings.info.url.clone(),
+            manifest_pubkey,
+            valid_from_epoch,
+            created_at,
+        )
+        .await?;
+
+    Ok(serde_json::to_string_pretty(&serde_json::json!({
+        "schema": delegation.schema,
+        "mint_url": delegation.mint_url,
+        "mint_identity_pubkey": delegation.mint_identity_pubkey.to_hex(),
+        "mint_identity_xonly_pubkey": delegation.mint_identity_pubkey.x_only_public_key().to_string(),
+        "manifest_pubkey": delegation.manifest_pubkey.to_hex(),
+        "valid_from_epoch": delegation.valid_from_epoch,
+        "created_at": delegation.created_at,
+        "signature": delegation.signature.to_string(),
+    }))?)
+}
