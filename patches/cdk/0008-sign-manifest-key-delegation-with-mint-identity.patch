+
+    const SEED: &[u8] = b"test-seed-solvent-manifest-key-delegation";
+    const MINT_URL: &str = "https://mint.example";
+
+    fn manifest_key() -> PublicKey {
+        // 2G — any valid point that is not the identity key.
+        PublicKey::from_hex("02c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5")
+            .expect("valid point")
