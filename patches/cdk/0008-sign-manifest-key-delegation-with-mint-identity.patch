+    /// J: the signing identity is the BIP32 master key of the seed, and it is
+    /// exactly the pubkey `keysets()` (and therefore NUT-06) exposes. A: a
+    /// valid delegation verifies under the x-only form of that key.
+    #[tokio::test]
+    async fn identity_is_the_seed_master_key_exposed_by_keysets() {
+        let s = signatory(SEED).await;
+        let secp = Secp256k1::new();
+        let master: PublicKey = Xpriv::new_master(bitcoin::Network::Bitcoin, SEED)
+            .expect("master")
+            .to_keypair(&secp)
+            .public_key()
+            .into();
+        let advertised = s.keysets().await.expect("keysets").pubkey;
+        assert_eq!(advertised, master);
+
+        let d = s
+            .sign_manifest_key_delegation(MINT_URL.to_string(), manifest_key(), 1, 1_790_000_000)
+            .await
+            .expect("delegation");
+        assert_eq!(d.mint_identity_pubkey, advertised);
+        let msg =
+            manifest_key_delegation_message(MINT_URL, &advertised, &manifest_key(), 1, 1_790_000_000)
+                .expect("message");
+        advertised
+            .verify(&msg, &d.signature)
+            .expect("A: verifies under the NUT-06 identity");
+        assert_eq!(
+            advertised.x_only_public_key().serialize().to_vec(),
+            advertised.to_bytes()[1..].to_vec()
+        );
+    }
+
+    /// A-E, H: the signature covers exactly the canonical message; changing
+    /// any field breaks it, and no other message verifies.
+    #[tokio::test]
+    async fn signature_binds_every_field() {
+        let s = signatory(SEED).await;
+        let id = s.keysets().await.expect("keysets").pubkey;
+        let d = s
+            .sign_manifest_key_delegation(MINT_URL.to_string(), manifest_key(), 5, 1_790_000_000)
+            .await
+            .expect("delegation");
+        assert_eq!(d.schema, MANIFEST_KEY_DELEGATION_SCHEMA);
+        let ok = |url: &str, man: &PublicKey, epoch: u64, at: u64| {
+            let m = manifest_key_delegation_message(url, &id, man, epoch, at).expect("message");
+            id.verify(&m, &d.signature).is_ok()
+        };
+        assert!(ok(MINT_URL, &manifest_key(), 5, 1_790_000_000));
+        let other_key = PublicKey::from_hex(
+            "02f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9",
