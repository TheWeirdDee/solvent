+/// SOLVENT Phase 3B: schema identifier of a manifest key delegation — the
+/// first field of, and the domain separator for, every delegation message.
+pub const MANIFEST_KEY_DELEGATION_SCHEMA: &str = "solvent/manifest-key-delegation/v1";
+
+/// SOLVENT Phase 3B: a delegation, signed by the mint's identity key (the
+/// signatory master key whose public key NUT-06 advertises), authorizing one
+/// SOLVENT manifest signing key from `valid_from_epoch` onwards. See
+/// `solvent/docs/manifest-key-delegation.md`.
+#[derive(Debug, Clone)]
+pub struct ManifestKeyDelegation {
+    /// Always [`MANIFEST_KEY_DELEGATION_SCHEMA`]
+    pub schema: String,
+    /// The mint URL this delegation is bound to
+    pub mint_url: String,
+    /// The mint identity (NUT-06) public key — set by the signatory, never by the caller
+    pub mint_identity_pubkey: PublicKey,
+    /// The authorized SOLVENT manifest public key
+    pub manifest_pubkey: PublicKey,
+    /// First PoL epoch this delegation covers
+    pub valid_from_epoch: u64,
+    /// Unix seconds
+    pub created_at: u64,
+    /// BIP-340 signature over SHA256(message) by the mint identity key
+    pub signature: Signature,
+}
+
+/// SOLVENT Phase 3B: the exact bytes a manifest key delegation signs.
+/// Deterministic, length-prefixed, fixed-width; the schema comes first as
+/// the domain separator:
+///
+/// ```text
+/// u16be(len(schema))   || schema (UTF-8)
+/// u16be(len(mint_url)) || mint_url (UTF-8)
+/// mint_identity_pubkey (33-byte compressed SEC1)
+/// manifest_pubkey      (33-byte compressed SEC1)
+/// u64be(valid_from_epoch)
+/// u64be(created_at)
+/// ```
+///
+/// Rejects inputs the delegation must never carry: an empty/oversized or
+/// non-http(s) mint URL, epoch 0 (SOLVENT epochs start at 1), a zero
+/// timestamp, and a manifest key equal to the identity key itself.
+pub fn manifest_key_delegation_message(
+    mint_url: &str,
+    mint_identity_pubkey: &PublicKey,
+    manifest_pubkey: &PublicKey,
+    valid_from_epoch: u64,
+    created_at: u64,
+) -> Result<Vec<u8>, Error> {
+    if mint_url.is_empty()
+        || mint_url.len() > u16::MAX as usize
