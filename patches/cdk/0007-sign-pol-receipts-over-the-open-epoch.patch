+    /// SOLVENT Phase 3A: signs each output's PoL receipt INSIDE the caller's
+    /// still-open write transaction, over the exact message SOLVENT's
+    /// accounting trigger stamped with the currently OPEN epoch
+    /// (`solvent/migrations/solvent-accounting/0003_pol_epoch_lifecycle.sql`).
+    /// Replaces Phase 2's pre-transaction signing over a hardcoded epoch 0:
+    /// the promised epoch only exists once the trigger has run, and because
+    /// CDK's SQLite transactions are `BEGIN IMMEDIATE`, no epoch close can
+    /// commit between that stamp and this transaction's commit — so a
+    /// receipt can never promise an already-closed epoch. Must be called
+    /// after `add_blind_signatures` for `outputs`. Outputs with no SOLVENT
+    /// receipt row (a database without SOLVENT's schema) are skipped. A
+    /// signing failure fails the whole operation closed. See
+    /// `solvent/docs/epoch-lifecycle.md`.
+    #[tracing::instrument(skip_all)]
+    pub async fn sign_pol_receipts_in_tx(
+        &self,
+        tx: &mut database::DynMintTransaction,
+        outputs: &[BlindedMessage],
+    ) -> Result<(), Error> {
+        for output in outputs {
+            let Some(message) = tx.get_pol_receipt_message(&output.blinded_secret).await? else {
+                continue;
+            };
+            let signature = self
+                .sign_pol_receipt(output.keyset_id, output.amount, message)
+                .await?;
+            tx.record_pol_receipt_signature(&output.blinded_secret, &signature.to_string())
+                .await?;
+        }
+        Ok(())
+    }
