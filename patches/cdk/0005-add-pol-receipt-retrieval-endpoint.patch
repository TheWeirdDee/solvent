+/// SOLVENT Phase 2 receipt delivery — retrieve a real PoL receipt
+///
+/// Looks up a signed (or still-pending) Proof-of-Liability receipt by the
+/// real, public `blinded_message` a wallet already received from a real
+/// NUT-04/NUT-03/NUT-05 response. A SOLVENT extension beyond the pinned
+/// draft's inline-response delivery — see docs/receipt-lifecycle.md in the
+/// SOLVENT repository for why, and docs/pol-extension.md for the
+/// classification of this as a named deviation. No wallet identity, no
+/// account, no proof secret: the lookup key is the same public value
+/// NUT-04 already returns to every caller.
+#[instrument(skip_all, fields(blinded_message = ?blinded_message))]
+pub(crate) async fn get_solvent_pol_receipt(
+    State(state): State<MintState>,
+    Path(blinded_message): Path<String>,
+) -> Result<Json<cdk::mint::PolReceiptStatus>, Response> {
+    let receipt = state.mint.get_pol_receipt(&blinded_message).await.map_err(|err| {
+        tracing::error!("Could not get PoL receipt: {}", err);
+        into_response(err)
+    })?;
+
+    Ok(Json(receipt))
+}
